# The updater's private key. It lives outside the repository (~/.relay) and in
# a CI secret; a copy in here would let anyone publish an update every install
# would trust.
*.key
relay-updater.key

# This repo installs with pnpm. An npm lockfile here desynchronises CI,
# which runs `pnpm install --frozen-lockfile`.
package-lock.json
